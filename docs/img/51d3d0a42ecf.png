98)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7931898)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7931898)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7931898" id="-7931898">kod harfi D yoki E boʻlganda, 60 m (45 m + 2x7,5 m);</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7931899)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7931899)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7931899)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7931899)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7931899" id="-7931899">kod harfi F boʻlganda, 75 m (45 m + 2x15 m).</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7931900)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7931900)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7931900)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7931900)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7931900" id="-7931900">11. Uchish-qoʻnish yoʻlagining yon xavfsizlik tasmasi qismlarini loyihalashda quyidagilarni hisobga olish kerak:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7931901)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7931901)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7931901)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7931901)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7931901" id="-7931901">samolyot uchish-qoʻnish yoʻlagidan chiqib ketganda, samolyotning konstruktiv shikastlanmasligini;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7931902)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7931902)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7931902)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7931902)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7931902" id="-7931902">samolyotni uchish-qoʻnish yoʻlagining xavfsizlik tasmasi qismlarida harakatlanishini;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7931903)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7931903)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7931903)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7931903)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7931903" id="-7931903">samolyotdan tushadigan yukka bardosh bera olishini.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7931904)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7931904)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7931904)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7931904)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7931904" id="-7931904">12. Aerodromning uchish-qoʻnish yoʻlagiga shamolning taʼsir qilish tezligi mazkur SHNQning 2-jadvaliga asosan belgilanishi lozim.</div></div><div class="TABLE_STD2 lx_elem" onmousemove="lx_mo(event,-7942684)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7942684)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7942684)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7942684)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7942684" id="-7942684"><table class="Table" style="width:100.0%;border-collapse:collapse" width="100%"><tbody><tr><td style="border-bottom:1px solid bla