06784)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906784)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906784)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906784)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906784" id="-7906784"><strong>Favqulodda vaziyatlar vazirining oʻrinbosari A. KULDASHEV</strong></div></div><div class="ACT_ESSENTIAL_ELEMENTS lx_elem" onmousemove="lx_mo(event,-7906785)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906785)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906785)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906785)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906785" id="-7906785"></div></div><div class="ACT_ESSENTIAL_ELEMENTS lx_elem" onmousemove="lx_mo(event,-7906786)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906786)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906786)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906786)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906786" id="-7906786">2022-yil 25-may</div></div><div class="BY_DEFAULT lx_elem" onmousemove="lx_mo(event,-7906787)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906787)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906787)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906787)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906787" id="-7906787"></div></div><div class="APPL_BANNER_LANDSCAPE_TITLE lx_elem" onmousemove="lx_mo(event,-7906788)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906788)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906788)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906788)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906788" id="-7906788">Oʻzbekiston Respublikasi qurilish vazirining 2022-yil 15-iyundagi 109-son buyrugʻiga<br />ILOVA</div></div><div class="ACT_TITLE_APPL lx_elem" onmousemove="lx_mo(event,-7906789)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906789)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906789)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906789)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906789" id="-7906789"><b>SHNQ 2.05.03-22 “Koʻpriklar va quvurlar” shaharsozlik normalari va qoidalari</b></div></div><div class="BY_DEFAULT lx_elem" onmousemove="lx_mo(event,-7906790)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906790)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906790)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906790)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906790" id="-7906790"></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906791)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906791)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906791)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906791)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906791" id="-7906791">Ushbu shaharsozlik normalari va qoidalari (keyingi oʻrinlarda — SHNQ) umumiy foydalanishdagi avtomobil yoʻllari, shaharlar va boshqa aholi punktlarining koʻchalari va xoʻjalik avtomobil yoʻllarida joylashgan sunʼiy inshootlarning (koʻpriklar, yoʻl oʻtkazgichlar, quvurlar va yer osti yoʻllari) asosiy konstruksiyalarini loyihalashda qoʻllaniladi.</div></div><div class="TEXT_HEADER_DEFAULT lx_elem" onmousemove="lx_mo(event,-7906792)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906792)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906792)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906792)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906792" id="-7906792"><b>1-bob. Normativ hujjatlarga havolalar</b></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906793)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906793)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906793)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906793)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906793" id="-7906793">1. Ushbu SHNQ da quyidagi texnik jihatdan tartibga solish sohasidagi normativ hujjatlarga havolalar keltirilgan:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906794)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906794)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906794)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906794)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906794" id="-7906794">GOST 17.5.1.03-86 Atrof muhit va yerni himoya qilish. Yerni biologik rekultivatsiya qilish uchun tasnif;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906795)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906795)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906795)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906795)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906795" id="-7906795">GOST 9.401-2018* Korroziyadan saqlanishning yagona sistemasi. Lakboʻyoq qatlami. Iqlim faktorlari taʼsiridagi turgʻunlikni umumiy texnik talablari va sinashni tezlashtirish usullari;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906796)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906796)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906796)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906796)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906796" id="-7906796">GOST 1050-2013 Yuqori sifatli uglerodli konstruktiv poʻlatdan maxsus sirt qoplamasi bilan kalibrlangan sortli prokat. Umumiy texnik shartlar;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906797)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906797)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906797)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906797)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906797" id="-7906797">GOST 380-2005 Odatiy sifatli uglerod poʻlat. Markalari;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906798)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906798)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906798)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906798)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906798" id="-7906798">GOST 535-2005 Saralangan va odatiy sifatli uglerod poʻlatli prokat. Umumiy texnik shartlar;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906799)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906799)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906799)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906799)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906799" id="-7906799">GOST 4543-2016 Konstruksiyaviy qotishma poʻlatdan yasalgan prokat mahsulotlari. Texnik shartlar;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906800)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906800)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906800)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906800)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906800" id="-7906800">GOST 4784-2019 Alyuminiy va deformatsiyalanadigan aluminiy qotishmalar. Markalar;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906801)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906801)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906801)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906801)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906801" id="-7906801">GOST 5632-2014 Yuqori qotishma poʻlat va qotishmalar korroziyaga chidamli, issiqlikka chidamli va issiqlikka mustahkam. Darajalar va qotishmalar;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7906802)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7906802)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7906802)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7906802)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7906802" id="-7906802">GOST 9128-2009 Asfaltbeton yoʻl aerodrom aralashmalari va asfaltbeton. Texnik shartlar;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(e