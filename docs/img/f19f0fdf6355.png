iv class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908278)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908278)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908278)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908278" id="-7908278"><i>l<sub>0</sub></i><sub> </sub> / <i>i</i> — element bukiluvchanligi (<i>i<font> —</font></i> koʻndalang kesimning eng kichik inersiya radiusi);</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908279)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908279)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908279)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908279)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908279" id="-7908279"><i>e<sub>c</sub>/r</i> — <i>N </i>kuchining nisbiy ekssentrisiteti;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908280)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908280)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908280)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908280)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908280" id="-7908280"><i>e<sub>c</sub></i> — <i>N</i> kuchining keltirilgan kesimda markaziy ogʻirlikka nisbatan ekssentrisiteti;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908281)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908281)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908281)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908281)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908281" id="-7908281">r =<img src="/files/7919008.jpg" /> yadroviy masofa (<em>W<sub>red</sub></em> va <em>A<sub>red</sub> </em>keltirilgan kesimning qarshilik momenti va maydoni).</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908282)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908282)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908282)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908282)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908282" id="-7908282">191. Kesimlardagi chegaraviy zoʻriqishlarni mazkur SHNQ ning 197<i><font> —</font></i> 206 va 210-bandlariga muvofiq quyidagi asoslardan kelib chiqqan holda aniqlash kerak:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908283)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908283)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908283)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908283)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908283" id="-7908283">betonning choʻzilishga qarshiligi nolga teng deb qabul qilinadi;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908284)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908284)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908284)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908284)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908284" id="-7908284">betonning siqilishga qarshiligi <em>R<sub>b</sub></em> ga barobar boʻlgan va uning shartli siqiladigan zonasi chegarasida teng taqsimlangan kuchlanishlar bilan cheklanadi;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908285)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908285)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908285)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908285)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908285" id="-7908285">armaturadagi choʻzuvchi kuchlanish, zoʻriqtirilmagan va zoʻriqtiriladigan armaturalarning choʻzilishga hisobiy qarshiliklari tegishli <em>R<sub>s</sub></em> va <em>R<sub>p</sub></em> lar bilan cheklanadi;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908286)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908286)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908286)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908286)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908286" id="-7908286">zoʻriqtirilmagan armaturadagi siquvchi kuchlanish, siqilishga hisobiy qarshilik <em>R<sub>so</sub></em> bilan, zoʻriqtiriladigandagi esa mazkur SHNQ ning 195-bandiga binoan eng katta siquvchi kuchlanishlar <em>σ<sub>ps</sub></em> bilan cheklanadilar;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908287)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908287)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908287)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908287)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908287" id="-7908287">kesimni QMQ 2.03.01ga binoan umumiy holga hisoblaganda, armaturadagi deformatsiya (kuchlanish), oldindan zoʻriqtirilgandagi deformatsiyani (kuchlanish) inobatga olib, betonning siqiladigan qismining balandligiga bogʻliq holda aniqlanadi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908288)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908288)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908288)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908288)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908288" id="-7908288">Tegishli tartibda asoslanganda, yuqorida koʻrsatilgan hisoblashlarni, beton va armaturaning deformatsiyasi diagrammasidan foydalanib bajarish ruxsat etiladi.</div></div><div class="FOOTNOTE lx_elem" onmousemove="lx_mo(event,-7908289)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908289)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908289)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908289)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908289" id="-7908289"><em>Izoh. Beton va armaturadagi hisobiy qarshiliklar va kuchlanishlar formulalarga MPa da kiritilishi kerak boʻlganida, matnda maxsus koʻrsatmalar beriladi.</em></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908290)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908290)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908290)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908290)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908290" id="-7908290">192. Hisobiy kesimning siqiladigan qismida har xil sinflardagi betonlar boʻlganida, ularning maydonlari hisobiy qarshiliklariga proporsional ravishda bitta hisobiy qarshilikdagi betonga keltiriladi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908291)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908291)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908291)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908291)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908291" id="-7908291">193. Siqiladigan qismida taxtasi joylashadigan toʻsinlarni hisoblashda, taxtaning qovurgʻa (devor) ichidan chiqib (osilib) turadigan hisobga kiritiladigan boʻlagining chiqib turgan joyining boshlanishidan oʻlchagandagi uzunligi, uning qalinligi <em>h′</em><sub><em>f</em>  </sub>ning olti marta koʻpaytirilgan qiymatidan oshmasligi va toʻsinlar qovurgʻalari orasidagi sof masofaning yarmisidan koʻp boʻlmasligi kerak.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908292)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908292)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908292)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908292)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908292" id="-7908292">Taxtaning chiqib turgan boʻlagining boshlanishi toʻsin qirrasidan yoki qiyaligi 1:3 va undan katta vut (qalinlashtirilgan qismi) boʻlganida, vutning oxiridan qabul qilinadi. Oʻzgaruvchi qalinlikdagi taxtalarda hamda vutlar qiyaligi 1:3 dan kichik boʻlgan hollarda, taxtaning chiqib (osilib) turadigan qismi uzunligi, taxta va vutlar maydonlarini hisobga olib topiladigan, taxtaning keltirilgan qalinligiga binoan aniqlanadi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908293)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908293)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908293)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908293)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908293" id="-7908293">Qoʻshtavr kesimlarning choʻziladigan belbogʻlarining chiqib turadigan qismlari maydoni hisoblashda inobatga olinmaydi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908294)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908294)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908294)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908294)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908294" id="-7908294">194. Choʻzilgan armaturaning soni, konstruktiv maqsadda yoki yorilishga pishiqlikka hisoblashga binoan, mustahkamlikka hisoblashdagi talab etilgan armatura sonidan ortiqcha boʻlganida, hisoblashda barcha armaturani emas, faqat mustahkamlikka talab etilganini inobatga olish ruxsat etiladi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908295)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908295)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908295)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908295)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908295" id="-7908295">195. Beton bilan jipslashib ketgan, ciqilgan qismda joylashgan zoʻriqtiriladigan armaturani hisoblashga quyidagi kuchlanish bilan kiritish kerak:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908297)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908297)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908297)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908297)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908297" id="-7908297"><img src="/files/7908296.png" style="height:24px;width:146px" />, (58)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908298)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908298)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908298)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908298)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908298" id="-7908298">bu yerda, <em>R<sub>pc</sub></em> — mazkur SHNQ ning 175-bandiga binoan, zoʻriqtiriladigan armaturadagi hisoblash bilan inobatga olinadigan eng katta siquvchi kuchlanish; <em>σ<sub>pc</sub></em><sub>1</sub> — zoʻriqtiriladigan armaturadagi hisobiy kuchlanish (barcha yoʻqolishlarni chiqarib tashlagandan keyingi), agar yuklamaga nisbatan ishonchlilik koeffitsiyenti γ<em>g</em>=1,1 boʻlsa; <em>σ<sub>pc</sub></em><sub>1</sub>≤<em>R<sub>pc </sub></em>boʻlganida, <em>σ<sub>pc</sub></em>=0<em> </em>deb qabul qilinadi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908299)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908299)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908299)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908299)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908299" id="-7908299">Siqilgan armaturaning koʻndalang kesimi maydoni <em>A′<sub>s</sub></em> ni betonning siqilgan qismi hisobiy balandligi x va ushbu armaturadan kesimning siqilgan qirrasigacha boʻlgan masofa <em>α′<sub>s </sub></em>lar nisbatlariga bogʻliq holda hisoblashga kiritiladi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908300)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908300)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908300)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908300)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908300" id="-7908300">Egiladigan elementlarni hisoblashda <em>x<sub>2</sub>≥2a′<sub>s</sub></em> boʻlganida, maydon <em>A′<sub>s</sub></em> toʻliq inobatga olinadi, bu yerda, <em>x<sup>2 </sup>—</em> siqilgan armatura <em>A′<sub>s </sub></em>ni hisobga olib aniqlanadigan siqilgan qismning balandligi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908301)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908301)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908301)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908301)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908301" id="-7908301">Siqilgan armaturani inobatga olmaganda kesimning siqilgan qism balandligi <em>x<sub>2</sub>≥2a′<sub>s </sub></em>uni inobatga olganda esa<em> x<sub>2</sub></em><<em>2a<sub>s</sub> </em>shartiga mos kelganida, mustahkamlikka hisoblashni quyidagi shartdan faydalanib bajarish, ruxsat etiladi:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908302)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908302)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908302)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908302)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908302" id="-7908302">M≤<em>(R<sub>p</sub>A<sub>p</sub>+R<sub>s</sub>A<sub>s</sub>)(h<sub>a</sub>-a′<sub>s</sub>) </em>(59)</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908304)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908304)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908304)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908304)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908304" id="-7908304"><img src="/files/7908303.png" style="height:22px;width:75px" /> boʻlganida, <em>A′<sub>s</sub></em> hisobga olinmaydi.</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908306)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908306)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908306)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908306)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908306" id="-7908306"><img src="/files/7919772.jpg" /> (60)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908307)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908307)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908307)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908307)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908307" id="-7908307">196. Element boʻylama oʻqiga normal kesimni hisoblash, tashqi kuch kesim simmetriya oʻqi tekisligida taʼsir etganida va armatura elementining koʻrsatilgan tekislikka perpendikulyar qirrasi oldida jamlangan boʻlganida, tegishli muvozanat shartidan aniqlanadigan siqilgan qism nisbiy balandligi ξ=<img src="/files/7919813.jpg" /> qiymatiga bogʻlik holda bajarilishi kerak. Konstruksiyani hisoblashda ξ ning qiymati tuzilgan armaturadan, uning uchun tegishli ishlash sharoiti koeffitsiyentini hisobga olgandagi hisobiy qarshilik <em>R<sub>s</sub></em> va <em>R<sub>p</sub></em> ga teng boʻlgan kuchlanish boʻlmaganga qadar betonning siqilgan qismida chegaraviy holat yuz bermaydigan holdagi, oʻsha qismining nisbiy balandligi ξ<sub>y</sub> dan oshmasligi kerak. ξ<sub>y </sub>qiymati quyidagi formula bilan aniqlanadi:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908309)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908309)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908309)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908309)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908309" id="-7908309"><img src="/files/7908308.png" style="height:39px;width:125px" /> (61)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908310)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908310)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908310)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908310)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908310" id="-7908310">bu yerda, <em>ω</em>=0,85-0,008 <em>R<sub>b</sub></em> — odatdagi (zoʻriqtirilmagan) armaturali elementlar uchun;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908312)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908312)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908312)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908312)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908312" id="-7908312"><em>ω</em>=0,85-0,008 <em>R<sub>b</sub></em>+<em>δ</em>≤0,9 — bevosita armaturali elementlar uchun;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908313)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908313)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908313)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908313)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908313" id="-7908313">bu yerda betonning hisobiy qarshiligi <em>R<sub>b </sub></em>ni MPa da, δ ning qiymatini esa 10 μ ga teng deb olish kerak, ammo 0,15 dan koʻp boʻlmasligi kerak.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908314)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908314)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908314)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908314)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908314" id="-7908314">armaturadagi kuchlanish σ<sub>1</sub> ni, MPa da, quyidagiga teng qilib olish kerak:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908315)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908315)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908315)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908315)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908315" id="-7908315">zoʻriqtirilmaydigan armatura uchun <i>R<sub>s</sub></i>;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908316)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908316)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908316)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908316)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908316" id="-7908316">zoʻriqtiriladigan armatura uchun <em>R<sub>p</sub>+500</em>–<em>σ<sub>p</sub></em>;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908317)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908317)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908317)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908317)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908317" id="-7908317">zoʻriqtiriladigan armaturaning hisobiy qarshiligi <em>R<sub>p</sub> </em>ni, uning tegishli ishlash sharoiti koeffitsiyentini inobatga olib, armaturadagi oldindan zoʻriqtiriladigan kuchlanish <em>σ<sub>p</sub></em>; qiymatini esa, mazkur SHNQ ning 12-ilovasiga binoan birinchi va ikkinchi yoʻqolishlarni hisobga olib qabul qilish kerak;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908318)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908318)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908318)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908318)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908318" id="-7908318">zoʻriqtirilgan va zoʻriqtirilmagan holda <em>σ<sub>1</sub></em> kuchlanishni zoʻriqtirilgan armaturaga koʻra qabul qilinadi;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908320)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908320)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908320)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908320)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908320" id="-7908320"><em>σ<sub>1 </sub></em>kuchlanish siqilgan qismdagi armaturadagi chegaraviy kuchlanish hisoblanadi va u 500 MPa ga teng deb qabul qilinishi kerak.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908321)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908321)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908321)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908321)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908321" id="-7908321">Mustahkamlikka hisoblashda, ξ<sub>y </sub>ning katta chegaraviy miqdoriga koʻra hisoblash orqali olingan <img src="/files/7919821.jpg" /> qiymatini saqlash asosli va zarur boʻlgan holda QMQ 2.03.01 koʻrsatmalariga rioya qilish tavsiya etiladi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908322)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908322)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908322)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908322)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908322" id="-7908322">Quyidagi hollardagi hisoblashlarda QMQ 2.03.01 koʻrsatmalariga rioya etish tavsiya etiladi:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908323)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908323)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908323)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908323)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908323" id="-7908323">temirbeton elementlarni qiya nomarkaziy siqilish va egilishlarga;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908324)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908324)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908324)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908324)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908324" id="-7908324">kesimi boʻylab armaturalar teng taqsimlangan elementlarni;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908325)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908325)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908325)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908325)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908325" id="-7908325">qisqa konsollarni, konstruksiyalarni botirib teshish va tortib ajratib olishga, qoʻyilgan buyumlar, koʻtargich ilmoqlar va buralish bilan egilishga, buralish bilan nomarkaziy siqilishga ishlaydigan elementlarni.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908326)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908326)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908326)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908326)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908326" id="-7908326">Uchburchakli, romb shakldagi va toʻgʻri burchakli boʻlmagan armaturasi jamlangan va teng taqsimlanib joylangan kesimlarni hisoblash uchun boshqa uslublarni qoʻllash, tegishli (oʻrnatilgan) tartibda ular asoslanganida ruxsat etiladi. Yumaloq kesimli temirbeton elementlarni nomarkaziy siqilishga mustahkamlikka hisoblash tavsiya etilgan mazkur SHNQ ning 9-ilovasida keltirilgan.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908327)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908327)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908327)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908327)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908327" id="-7908327">Barcha sanab oʻtilgan hisoblashlarda beton va armatura uchun meʼyorlarda belgilangan hisobiy qarshiliklarni olish kerak. Normal kuchlanishlarni oldindan zoʻriqtirilgan egri toʻsin kesimlarida yoriqbardoshlikni mazkur SHNQ ning 14-ilovasi boʻyicha hisoblash tavsiya etiladi.</div></div><div class="TEXT_HEADER_DEFAULT lx_elem" onmousemove="lx_mo(event,-7908328)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908328)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908328)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908328)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908328" id="-7908328"><b>2-§. Egiladigan temirbeton elementlarni hisoblash</b></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908329)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908329)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908329)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908329)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908329" id="-7908329">197. Toʻgʻri burchakli kesimlarni <img src="/files/7964062.jpg" /> boʻlganidagi hisoblashni quyidagi shartga koʻra bajarish kerak:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908330)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908330)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908330)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908330)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908330" id="-7908330">M ≤ R<sub>b</sub>bx(h<sub>0</sub> – 0,5x) +R<sub>s c</sub>Aʼ<sub>s</sub>(h<sub>01</sub> – aʼ<sub>s</sub>) + σ<sub>pc</sub>Aʼ<sub>p</sub> (h<sub>0</sub> – aʼ<sub>p</sub>), (62)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908331)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908331)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908331)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908331)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908331" id="-7908331">bu yerda, siqilgan qism balandligi <em>x </em>ni quyidagi formula bilan aniqlash kerak:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908332)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908332)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908332)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908332)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908332" id="-7908332">R<sub>p</sub>A<sub>p</sub> + R<sub>s</sub>A<sub>s</sub> – R<sub>sc</sub>A<sub>s</sub> – σ<sub>pc</sub>Aʼ<sub>p </sub>= R<sub>b</sub>bx (63)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908333)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908333)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908333)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908333)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908333" id="-7908333">Bu yerda va bosh formulalardagi balandlik h<sub>0</sub> ni A<sub>p</sub> va A<sub>5</sub> armaturadagi zoʻriqish teng taʼsir etuvchisidan olish kerak. Zoʻriqtiriladigan armatura boʻlmaganida, h<sub>0</sub>=h<sub>01</sub></div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908335)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908335)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908335)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908335)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908335" id="-7908335"><img src="/files/7908334.png" style="height:30px;width:72px" /></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908337)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908337)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908337)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908337)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908337" id="-7908337"><img src="/files/7908336.png" style="height:27px;width:99px" /> bu yerda ∞ mazkur SHNQ ning 4, 6, 7-ilovalari boʻyicha aniqlanadi.</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908339)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908339)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908339)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908339)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908339" id="-7908339"><img src="/files/7908338.png" style="height:169px;width:369px" /></div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908340)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908340)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908340)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908340)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908340" id="-7908340"><em>2-rasm. Egiladigan temirbeton elementning boʻylama oʻqiga normal kesimdagi, uni mustahkamlikka hisoblashdagi zoʻriqish va kuchlanish epyurasining sxemasi</em></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908341)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908341)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908341)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908341)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908341" id="-7908341">Avtomobil yoʻllari va shahar koʻpriklari qovurgʻali oraliq qurilmalari oʻtish qismi plitasining boʻylama yoʻnalishdagi ulangan joylarini mustahkamlikka hisoblash (62) va (63) formulalarning oʻng tomonidagi formulalarga quyidagi ishlash sharoiti koeffitsiyentlarini kiritib bajariladi:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908342)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908342)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908342)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908342)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908342" id="-7908342">diafragmalilari uchun — 0,8 ga teng;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908343)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908343)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908343)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908343)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908343" id="-7908343">diafragmali oraliq qurilmalar uchun — 0,9 ga teng.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908344)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908344)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908344)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908344)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908344" id="-7908344">198. Tavrli, qoʻshtavrli va qutisimon, plitasi siqilgan qismda joylashgan kesimlarni <img src="/files/7919849.jpg" /> boʻlganida hisoblashni siqilgan qism chegarasi holatiga bogʻlik holda bajarish kerak:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908345)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908345)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908345)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908345)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908345" id="-7908345">a) siqilgan qism chegarali plitada oʻtganida (3 rasm, a) yoki quyidagi shart bajarilganida</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908347)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908347)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908347)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908347)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908347" id="-7908347"><img src="/files/7908346.png" style="height:24px;width:335px" /> (64)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908348)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908348)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908348)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908348)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908348" id="-7908348">Mazkur SHNQ ning 197-bandiga muvofiq <em>b'<sub>f</sub></em>  endagi toʻgʻri burchakli kesim hisoblangandek hisoblanadi;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908349)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908349)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908349)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908349)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908349" id="-7908349">b) siqilgan qism chegarali qovurgʻadan oʻtganida (3 rasm, b) yoki (64) shart bajarilmaydi, unda hisoblash quyidagi shartga binoan bajarilishi kerak:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908350)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908350)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908350)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908350)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908350" id="-7908350">M≤<em>Rb bx(h<sub>0 </sub></em><em>– </em><em>0,5x)+R<sub>b</sub>(b′<sub>f </sub></em><em>– </em><em>b)h′<sub>f</sub>(h<sub>0 </sub></em><em>– 0,5h′<sub>f</sub>)+R<sub>so</sub>A′<sub>s</sub>+ σ<sub>pc</sub>A′<sub>s </sub> (h<sub>01</sub> – a'<sub>s</sub>) a<sub>pc</sub>A′<sub>p </sub> (h<sub>0</sub> – a'<sub>p</sub>) </em>(65)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908351)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908351)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908351)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908351)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908351" id="-7908351">bu yerda, betonning siqilgan qismi balandligini x quyidagi formula bilan aniqlash kerak:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908353)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908353)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908353)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908353)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908353" id="-7908353"><img src="/files/7908352.png" style="height:24px;width:456px" /> (66)</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908355)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908355)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908355)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908355)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908355" id="-7908355"><img src="/files/7908354.png" style="height:180px;width:361px" /></div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908356)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908356)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908356)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908356)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908356" id="-7908356"><em>3-rasm. Plitasi siqilgan qismda boʻlgan temirbeton elementlarning kesimlaridagi siqilgan qismlarning shakli</em></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908357)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908357)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908357)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908357)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908357" id="-7908357">a) siqilgan qism chegarali plitada joylashganda,</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908358)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908358)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908358)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908358)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908358" id="-7908358">b) siqilgan qism chegarali qovurgʻada joylashganda.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908359)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908359)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908359)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908359)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908359" id="-7908359">199. Halqa kesimli, ichki va tashqi radiuslarining nisbati <img src="/files/7919851.jpg" /> boʻlgan, armaturasi aylana boʻylab teng taqsimlangan (boʻylama yoʻnalishdagi sterjenlar soni 6 tadan kam boʻlmagan), egiluvchi elementlar hisobi, mazkur SHNQ ning <a href="/docs/-6130301#-7908366">202-bandiga </a>muvofiq, nomarkaziy siqiladigan elementlar hisobini bajargandek, N<em>e<sub>c </sub></em>qiymat oʻrniga eguvchi moment M qiymatini boʻylama kuch qiymati N = 0 deb qabul qilinib bajariladi.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908360)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908360)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908360)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908360)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908360" id="-7908360">200. Avtomobil yoʻllari koʻpriklarining egiladigan temirbeton elementlaridagi zoʻriqtiriladigan ishchi armatura beton bilan jipslashmagan holda, kesimini mustahkamlikka mazkur SHNQ ning 193 va 194-bandlariga muvofiq tegishli formulalarda zoʻriqtiriladigan armaturaning choʻzilishga hisobiy qarshiligi <em>R<sub>p</sub></em> oʻrniga oʻsha armaturadagi oldindan zoʻriqtirilganda belgilangan (barcha yoʻqolishlar chiqarib tashlangandan keyingi) kuchlanish qiymati <em>σ</em><sub>p1</sub> ni kiritib hisoblash kerak. Bundan tashqari, uzunasiga alohida tayyorlangan bloklardan yigʻiladigan konstruksiyalarda, elastik materiallar qarshiligi formulalari bilan hisobiy yuklamalarga (yuklamalarga nisbatan ishonchlilik koeffitsiyenti bilan) oldindan zoʻriqtirish kuchini ham kiritib, qoʻshimcha hisoblash oʻtkazish kerak. Ishlashning barcha bosqichlarida, bloklar bir-biriga ulangan joylarda zoʻriqtirilmaydigan armatura qoʻyilmagan holda, tashqi kuchlardan choʻzuvchi kuchlanish hosil boʻladigan qismlarda, ushbu kuchlanish mavjud boʻlishi mumkin emas.</div></div><div class="TEXT_HEADER_DEFAULT lx_elem" onmousemove="lx_mo(event,-7908361)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908361)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908361)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908361)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908361" id="-7908361"><b>3-§. Nomarkaziy siqiladigan beton elementlarni hisoblash</b></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908362)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908362)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908362)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908362)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908362" id="-7908362">201. Boshlangʻich ekssentrisiteti e<sub>c</sub> ≤ r boʻlgan nomarkaziy siqiladigan beton elementlarni quyidagi shartni bajargan holda ustivorlikka hisoblash kerak:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908363)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908363)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908363)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908363)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908363" id="-7908363">N ≤ φR<sub>b</sub>A<sub>b </sub>(67)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908364)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908364)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908364)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908364)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908364" id="-7908364">bu yerda, φ — 186. boʻyicha olinadigan koeffitsiyent;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908365)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908365)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908365)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908365)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908365" id="-7908365">A<sub>b</sub> — elementning siqilgan kesim maydoni.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908366)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908366)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908366)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908366)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908366" id="-7908366">202. Nomarkaziy siqiladigan beton elementlarni e<sub>c</sub> > r (r — 186-bandiga binoan yadro masofasi) boʻlgan holda, mustahkamlikka hisoblash neytral oʻq holatiga va quyidagi formuladan topiladigan a-ning qiymatiga bogʻliq holda bajariladi:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908367)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908367)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908367)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908367)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908367" id="-7908367">a = a<sub>c</sub> – e<sub>c</sub>ƞ (68)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908368)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908368)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908368)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908368)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908368" id="-7908368">bu yerda, a — boʻylama kuch N qoʻyilgan nuqtadan kesimning koʻproq siqilgan qirrasigacha boʻlgan, mazkur SHNQ ning 189-bandiga binoan aniqlanadigan ƞ koeffitsiyentni inobatga olgandagi masofa;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908369)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908369)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908369)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908369)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908369" id="-7908369">a<sub>c</sub> — toʻla kesimning ogʻirlik markazi orqali oʻtadigan oʻqdan koʻproq siqilgan qirrasigacha boʻlgan masofa;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908370)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908370)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908370)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908370)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908370" id="-7908370">e<sub>c </sub>— boʻylama kuch <i>N</i> ning, toʻla kesim ogʻirlik markaziga nisbatan boshlangʻich ekssentrisiteti.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908371)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908371)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908371)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908371)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908371" id="-7908371">Bunda, tashqi kuchlar teng taʼsir etuvchisi quyidagi shartga rioya qilgan holda, element koʻndalang kesimi chegarasida boʻlishi zarur:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908372)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908372)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908372)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908372)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908372" id="-7908372">E<sub>c</sub>ƞ ≤ 0,8a<sub>c</sub> (69)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908373)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908373)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908373)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908373)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908373" id="-7908373">203. Tavr, qoʻshtavr va qutisimon plitasi siqilgan qismda joylashgan (3.3 rasm), nomarkaziy siqiladigan beton elementlarni hisoblashda kesimning mustahkamligi quyidagi shart bajarilganda taʼminlanadi:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908374)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908374)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908374)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908374)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908374" id="-7908374">N ≤ R<sub>b</sub>bx + R<sub>b</sub> (bʼ<sub>ʄ</sub> – b) hʼ<sub>ʄ</sub> (70)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908375)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908375)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908375)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908375)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908375" id="-7908375">bunda siqilgan qism balandligi quyidagicha aniqlanadi: a>0,5<em>h'<sub>f</sub></em></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908376)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908376)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908376)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908376)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908376" id="-7908376">a>0,5<em>hʼ<sub>f</sub></em>    boʻlganida (neytral oʻq qovurgʻa chegarasidan oʻtadi)</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908378)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908378)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908378)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908378)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908378" id="-7908378"><img src="/files/7908377.png" style="height:49px;width:216px" /> (71)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908380)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908380)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908380)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908380)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908380" id="-7908380">a≤0,5<em>h'<sub>f</sub> </em>boʻlganida (neytral oʻq siqilgan plita chegarasidan oʻtadi), hisoblash uchun<em> b</em> ni <em>b′<sub>f</sub></em> ga almashtirib, (70) va (71) formulalardan foydalaniladi.</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908382)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908382)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908382)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908382)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908382" id="-7908382"><img src="/files/7908381.png" style="height:151px;width:327px" /></div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908383)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908383)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908383)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908383)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908383" id="-7908383"><em>4-rasm. Nomarkaziy siqilgan beton elementning boʻylama oʻqiga normal kesimdagi zoʻriqish va kuchlanish epyurasining sxemasi</em></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908384)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908384)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908384)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908384)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908384" id="-7908384">Toʻgʻri burchakli kesimli nomarkaziy siqilgan elementlarni hisoblashda quyidagi shart bajarilganda mustaqkamlik taʼminlanadi:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908385)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908385)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908385)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908385)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908385" id="-7908385">N≤R<sub>b</sub>bx, (72)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908386)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908386)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908386)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908386)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908386" id="-7908386">bu yerda siqilgan qism balandligi quyidagi formula bilan aniqlanadi:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908387)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908387)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908387)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908387)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908387" id="-7908387">x=h­-2e<sub>c</sub>η (73)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908388)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908388)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908388)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908388)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908388" id="-7908388">Eguvchi moment taʼsir koʻrsatadigan tekislikda mustahkamlikka hisoblashdan tashqari element <em>u</em> tekislikka tik yoʻnalishda egilish bilan ustivorlikka hisoblanib tekshirilishi kerak.</div></div><div class="TEXT_HEADER_DEFAULT lx_elem" onmousemove="lx_mo(event,-7908389)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908389)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908389)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908389)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908389" id="-7908389"><b>4-§. Nomarkaziy siqilgan temirbeton elementlarni hisoblash</b></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908390)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908390)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908390)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908390)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908390" id="-7908390">204. Hisoblash ekssentrisiteti <em>e<sub>s</sub>≤r </em>boʻlgan nomarkaziy siqilgan temirbeton elementlarni quyidagi shartlardan kelib chiqqan holda mustahkamlikka va ustivorlikka hisoblash kerak:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908391)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908391)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908391)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908391)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908391" id="-7908391">a) ustivorlikka hisoblashda:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908392)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908392)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908392)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908392)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908392" id="-7908392">armatura beton bilan jipslashgan holda</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7908393)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908393)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908393)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908393)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7908393" id="-7908393"><img src="/files/7922288.jpg" /> (74)</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7908394)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7908394)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7908394)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7908394)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><di