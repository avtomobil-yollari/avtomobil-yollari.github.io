            $("#docContent__sideBar-show").click(function () {
                if ($("body").hasClass("sidebar-show")) {
                    $("body").removeClass("sidebar-show")
                }
                else {
                    $("body").addClass("sidebar-show")
                    window.dispatchEvent(new Event("scroll")); // main.js: place contents below the header
                }
            })

            // phone: contents is a drawer over the document - close it on tapping the dimmed part or after jumping to a heading
            $("#lxTocBackdrop").click(function () {
                $("body").removeClass("sidebar-show");
            });
            // capture phase: links of items with children are .stopProp (stopPropagation, so the heading tap doesn't
            // expand/collapse the item) - a bubbling handler on the panel never sees their clicks
            document.getElementById("docBody__sidebar").addEventListener("click", function (e) {
                if (e.target.closest("a.search-text") && window.matchMedia("(max-width: 992px)").matches)
                    $("body").removeClass("sidebar-show");
            }, true);
            
        </script>
