border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="34%"><p align="center" style="margin:0in;margin-bottom:.0001pt;text-align:center;font-size:12.0pt;font-family:  "Times New Roman",serif">1/10d<sup>2</sup></p></td><td style="width:37.88%;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" width="37%"><p align="center" style="margin:0in;margin-bottom:.0001pt;text-align:center;font-size:12.0pt;font-family:  "Times New Roman",serif">1/5d<sup>2</sup></p></td></tr></tbody></table></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911211)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911211)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911211)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911211)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911211" id="-7911211">6.7-jadvaldagi belgilashlar:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911212)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911212)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911212)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911212)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911212" id="-7911212">t — birlashtirilayotgan elementlarning eng yupqasining qalinligi, sm da;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911213)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911213)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911213)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911213)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911213" id="-7911213">d — mix, dyubel yoki pona (nagel)ning diametri, sm, da.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911214)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911214)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911214)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911214)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911214" id="-7911214">583. Bir nechtadan tashkil topgan elementlarning keltirilgan egiluvchanlik koeffitsiyentlarini aniqlayotganda quyidagi shartlarni bajarish kerak:</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911215)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911215)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911215)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911215)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911215" id="-7911215">a) qistirib mahkamlangan uchlari 4 d dan kam boʻlgan mixlar va dyubellar hisobga olinmasligi kerak;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911216)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911216)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911216)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911216)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911216" id="-7911216">b) shaxobchalarni pona (shponka)lar yoki kolodkalar yordamida birlashtirganda <span style="font-family:Symbol">m</span><sub>z</sub> = 1,2 deb qabul qilish kerak;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911217)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911217)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911217)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911217)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911217" id="-7911217">v) choklarda ikki xil diametrdagi (d<sub>1</sub> va d<sub>2</sub>) pona (nagel) lar qoʻllanilganida, bogʻlovchilarning chokdagi qirqiladiganlarining soni n quyidagi formula bilan aniqlanadi:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7911219)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911219)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911219)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911219)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911219" id="-7911219"><img src="/files/7911218.png" style="height:44px;width:182px" /></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911220)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911220)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911220)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911220)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911220" id="-7911220">bu yerda, n<sub>1</sub>, <span style="font-family:Symbol">d</span><sub>1</sub> — d<sub>1 </sub>diametrdagi pona (nagel)larga toʻgʻri keladigan qirqimlar soni va koʻnikuvchanlik koeffitsiyenti;</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911221)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911221)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911221)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911221)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911221" id="-7911221">n<sub>2</sub>, <span style="font-family:Symbol">d</span><sub>2</sub> — d<sub>2</sub> diametrdagi pona (nagel)larga toʻgʻri keladigan qirqimlar soni va koʻnikuvchanlik koeffitsiyenti.</div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911222)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911222)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911222)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911222)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911222" id="-7911222">584. Markaziy siqiluvchan elementlarning qabul qiluvchanlik (koʻtaruvchanlik) qobiliyatining kamayish koeffitsiyenti <span style="font-family:Symbol">j</span> ni ularning egiluvchanligiga bogʻliq ravishda quyidagi formula bilan aniqlash lozim:</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7911223)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911223)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911223)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911223)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911223" id="-7911223">λ≤70 boʻlganida, φ = 1 — 0.8 (λ/100)<sup>2</sup>; (297)</div></div><div class="TEXT_CENTER lx_elem" onmousemove="lx_mo(event,-7911224)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911224)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911224)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911224)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911224" id="-7911224">λ>70 boʻlganida, φ = 3000/λ<sup>2</sup>; (298)</div></div><div class="TEXT_HEADER_DEFAULT lx_elem" onmousemove="lx_mo(event,-7911225)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911225)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911225)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911225)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911225" id="-7911225"><b>5-§. Konstruksiya elementlarini hisoblash</b></div></div><div class="ACT_TEXT lx_elem" onmousemove="lx_mo(event,-7911226)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7911226)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7911226)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7911226)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7911226" id="-7911226">585. Koʻpriklarning yogʻoch konstruksiyalarining elementlarini mustahkamlikka va ustivorlikka hisoblashni quyidagi 104-jadvaldagi formulalarga binoan bajarish zarur.</div></div><div class="TABLE_STD2 lx_elem" onmousemove="lx_mo(event,-7943001)"><div class="lx_elem2"><div class="lx_elem3"><span onclick="lx_sf(-7943001)"><img src="/img/cmt.svg" />Ҳужжатга таклиф юбориш</span><span onclick="lx_pa(-7943001)"><img src="/img/vlm.svg" />Аудиони тинглаш</span><span onclick="lx_cl(-7943001)"><img src="/img/lnk.svg" />Ҳужжат элементидан ҳавола олиш</span></div></div><div name="-7943001" id="-7943001"><table border="1" cellpadding="0" cellspacing="0" style="width:100.0%;border-collapse:collapse;border:none" width="100%"><tbody><tr><td style="width:58.44%;border:none;border-bottom:  solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="58%"><p align="center" style="margin:0in;margin-bottom:.0001pt;text-align:center;font-size:12.0pt;font-family:  "Times New Roman",serif"></p></td><td style="width:41.56%;border:none;border-bottom:  solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="41%"><p align="right" style="margin:0in;margin-bottom:.0001pt;text-align:right;font-size:12.0pt;font-family:"Times New Roman",serif">104-jadval</p></td></tr><tr><td style="width:58.44%;border:solid windowtext 1.0pt;bord