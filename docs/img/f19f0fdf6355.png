rder-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="17%"><p align="center" style="text-align:center">10</p></td><td style="width:17.7%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="17%"><p align="center" style="text-align:center">8</p></td></tr><tr><td style="width:64.62%;border-top:none;border-left:  solid windowtext 1.0pt;border-bottom:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="64%"><p>pastki plitalari</p></td><td style="width:17.7%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="17%"><p align="center" style="text-align:center">12</p></td><td style="width:17.7%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="17%"><p align="center" style="text-align:center">10</p></td></tr><tr><td style="width:64.62%;border-top:none;border-left:  solid windowtext 1.0pt;border-bottom:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="64%"><p>b) strunobetonli:</p></td><td style="width:17.7%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="17%"><p align="center" style="text-align:center"></p></td><td style="width:17.7%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="17%"><p align="center" style="text-align:center"></p></td></tr><tr><td style="width:64.62%;border-top:none;border-left:  solid windowtext 1.0pt;border-bottom:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="64%"><p>devorchalar va ustki plitalari</p></td><td style="width:17.7%;border:none;border-right:solid windowtext 1.0pt;padding:0in 2.85pt 0in 2.85pt" valign="top" width="17%"><p align="center" style="text-align:center">-</p></td><td style="width:17.7%;border:none;border-right:solid windowtext 1.0pt;padding: